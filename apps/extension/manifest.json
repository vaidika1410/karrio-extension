{
  "manifest_version": 3,

  "name": "Karrio",

  "version": "1.0.0",

  "description": "Save job applications to Karrio",

  "permissions": [
    "activeTab",
    "storage"
  ],

  "host_permissions": [
    "https://www.linkedin.com/*",
    "http://localhost:3000/*"
  ],

  "action": {
    "default_popup": "popup.html"
  },

  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "js": ["content.js"]
    }
  ]
}